# Supabase Configuration
# Get these values from your Supabase project settings

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anonymous) key - safe to expose in browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret (service role) key - NEVER expose to browser, server-only
SUPABASE_SECRET_KEY=

# WebRTC ICE configuration (all values below are read server-side)
# Comma-separated STUN URLs. A public STUN service may be used for local tests.
WEBRTC_STUN_URLS=

# Comma-separated coturn-compatible endpoints. Include UDP plus TCP and TLS for
# production, for example:
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
WEBRTC_TURN_URLS=

# coturn static-auth-secret. NEVER prefix this variable with NEXT_PUBLIC_.
WEBRTC_TURN_SHARED_SECRET=

# Short-lived credential lifetime in seconds (clamped to 60-3600; default 600).
WEBRTC_TURN_TTL_SECONDS=600

# all (default) or relay. relay prevents direct peer candidates but requires TURN.
WEBRTC_ICE_TRANSPORT_POLICY=all

# Explicit local-development escape hatch when TURN is unavailable. STUN alone
# does not provide reliable production connectivity across restrictive NATs.
WEBRTC_ALLOW_STUN_ONLY=false
