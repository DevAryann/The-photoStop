# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com

# Public Supabase URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous key (safe to expose to browser, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (NEVER expose to browser, server-side only, full database access)
SUPABASE_SERVICE_ROLE_KEY=
